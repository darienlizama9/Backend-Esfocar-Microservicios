# ==============================================================================
# VARIABLES DE ENTORNO RECOMENDADAS PARA RENDER
# ==============================================================================
# Puerto asignado automáticamente por Render (no es necesario crearlo manualmente en Render,
# pero si pruebas en local puedes definirlo)
PORT=8080

# Conexión JDBC a PostgreSQL en Neon
# Asegúrate de usar la URL con endpoint pooler y parámetro sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxxxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=tu_password_aqui

# Configuración Hibernate (opcional)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Configuración HikariCP (opcional, tiene valores por defecto optimizados)
HIKARI_MAX_POOL_SIZE=5
HIKARI_MIN_IDLE=2
